# ==============================================================================
# AnchorIQ Environment Configuration Template
# ==============================================================================
# Security Notes:
# 1. SUPABASE_ANON_KEY is a public client key by design; it can safely reside on frontend and backend.
# 2. No Supabase service-role key is used anywhere in AnchorIQ.
# 3. CLOUDINARY_API_SECRET and SUPABASE_DB_URL contain sensitive credentials and must ONLY be set on the BACKEND.
# 4. Never commit actual secret values into version control.

# ==============================================================================
# BACKEND SERVICES — REQUIRED
# ==============================================================================

# PostgreSQL database connection string with session pooler.
# Used by: BACKEND
# Location: Supabase > Project Settings > Database > Connection string > Session pooler (URI format)
# Required: YES (Fail-fast on startup)
SUPABASE_DB_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Base URL of your Supabase project REST and Auth API.
# Used by: BOTH (Backend validates Bearer tokens; Frontend authenticates users)
# Location: Supabase > Project Settings > API > Project URL
# Required: YES (Fail-fast on startup)
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase Anonymous public API key (used for client requests and auth verification).
# Used by: BOTH (Backend verifies Bearer tokens via Auth REST API; Frontend sends sign-in/sign-up requests)
# Location: Supabase > Project Settings > API > Project API keys > anon / public
# Required: YES (Fail-fast on startup)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Cloudinary cloud tenant name for asset storage.
# Used by: BACKEND
# Location: Cloudinary Dashboard > Account Details > Cloud Name
# Required: YES (Fail-fast on startup)
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API key for uploading and managing charts and raw model bundles.
# Used by: BACKEND
# Location: Cloudinary Dashboard > Account Details > API Key
# Required: YES (Fail-fast on startup)
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API secret for authenticating private assets and generating short-lived signed URLs.
# Used by: BACKEND
# Location: Cloudinary Dashboard > Account Details > API Secret (Keep confidential; NEVER set on frontend)
# Required: YES (Fail-fast on startup)
CLOUDINARY_API_SECRET=your_api_secret


# ==============================================================================
# BACKEND SERVICES — OPTIONAL
# ==============================================================================

# Groq Cloud API key for generating AI executive insights and business agent responses.
# Used by: BACKEND
# Location: Groq Console (https://console.groq.com/keys)
# Required: OPTIONAL (Default: blank; system falls back to rule-based insights and analysis)
GROQ_API_KEY=

# Preferred LLM model name on Groq.
# Used by: BACKEND
# Location: Groq Documentation > Supported Models
# Required: OPTIONAL (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Maximum allowed uploaded dataset size in Megabytes.
# Used by: BACKEND
# Location: Application configuration
# Required: OPTIONAL (Default: 20)
MAX_UPLOAD_SIZE_MB=20

# Time budget in seconds for automated machine learning model exploration and cross-validation.
# Used by: BACKEND
# Location: Application configuration
# Required: OPTIONAL (Default: 60)
MODEL_TIME_BUDGET=60

# Comma-separated list of allowed frontend origins for Cross-Origin Resource Sharing (CORS).
# Used by: BACKEND
# Location: Deployment URL of your Streamlit app (e.g. https://your-app.streamlit.app)
# Required: OPTIONAL (Default: http://localhost:8501)
CORS_ORIGINS=http://localhost:8501


# ==============================================================================
# FRONTEND SERVICES — REQUIRED
# ==============================================================================

# Public URL of the deployed FastAPI backend REST API.
# Used by: FRONTEND
# Location: Render / Hugging Face Spaces service URL (or http://localhost:8000 for local development)
# Required: YES (Default: http://localhost:8000)
API_URL=http://localhost:8000
