# AnchorIQ Environment Configuration (Placeholders Only - Never commit actual secrets)

# Groq API Key for AI Executive Insights (llama-3.1-8b-instant / llama-3.3-70b-versatile)
# Leave empty to use built-in deterministic rule-based insights engine
GROQ_API_KEY=

# Supabase PostgreSQL connection string (Project Settings > Database > Connection string).
# Prefer the Session pooler URI for deployed/serverless environments; keep sslmode=require.
SUPABASE_DB_URL=
# DATABASE_URL remains supported as an alternative to SUPABASE_DB_URL.
DATABASE_URL=
# SQLite is used only when Supabase is not configured or is temporarily unavailable.
ANCHORIQ_EMERGENCY_DB_PATH=./anchoriq_local.db

# Cloudinary credentials. Charts are uploaded as images; datasets, models and PDFs use
# authenticated raw assets and are not publicly downloadable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload size limit in Megabytes (default: 20)
MAX_UPLOAD_SIZE_MB=20
